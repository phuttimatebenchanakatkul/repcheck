.env
__pycache__/
*.pyc
uploads/
progress_photos/
# Glob, not the bare filename: this repo is public, and the plain pattern
# left backups (repcheck.db.bak-*) and SQLite's own sidecars (-wal, -shm,
# -journal) untracked-but-not-ignored, one `git add -A` away from publishing
# every user's email, password hash, and health data.
repcheck.db*
*.mp4
*.mov
*.MOV
# ...except the marketing site's demo clips. Render deploys that static site
# straight from the repo, so an ignored clip is a 404 in production. These are
# deliberately-published screen recordings with the iOS/Safari chrome cropped
# off -- keep raw camera footage and user uploads out, as above.
!marketing/*.mp4
.vscode/
.idea/
.claude/
.gstack/

# Diagnostic logs. Public repo -- these capture live request payloads
# (profile fields, weights) and must never be committed.
*.log

# JS test runtime (vitest + jsdom) added to test inline template scripts.
# package.json/package-lock.json ARE committed -- this repo has no build
# step and node_modules is the only generated artifact.
node_modules/

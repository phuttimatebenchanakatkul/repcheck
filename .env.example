# Copy to .env and fill in. .env is gitignored; never commit real values.
# On Render these same names go in the dashboard's Environment tab instead.

# Signs the session cookie. The app refuses to boot without it.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Google sign-in ----------------------------------------------------
# Both must be set or the "Continue with Google" button stays disabled and
# renders a "setup needed" badge (auth.py's _auth_context).
#
# Create them at https://console.cloud.google.com/apis/credentials:
#   Create credentials -> OAuth client ID -> Web application
#   Authorized redirect URIs -- add BOTH, exactly, no trailing slash:
#     http://localhost:5000/auth/google/callback
#     https://repcheck-q0m4.onrender.com/auth/google/callback
#   (add one per port if you run worktrees on 5050 etc.)
#
# The redirect URI Google receives is built from the incoming request, so
# it must match one of the entries above character for character or Google
# refuses with redirect_uri_mismatch before the user ever comes back here.
#
# The OAuth consent screen also needs the email/profile/openid scopes and,
# while it is in "Testing" mode, every account that will sign in listed
# under Test users -- otherwise Google shows "access blocked" to everyone
# but the owner. Publishing the app removes that limit.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Apple sign-in (not implemented past the redirect -- see auth.py) ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

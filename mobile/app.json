{
  "expo": {
    "name": "RepCheck",
    "slug": "repcheck",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "repcheck",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.benchanakatkul.repcheck",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.benchanakatkul.repcheck",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0c",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "RepCheck uses the camera to scan barcodes and photograph meals so it can estimate their calories and macros."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RepCheck reads a photo or video you choose so it can estimate a meal's calories and macros, or grade your form on a set.",
          "cameraPermission": "RepCheck uses the camera to photograph a meal, or to film a set so it can grade your form.",
          "microphonePermission": "RepCheck records sound along with the video when you film a set to have your form graded."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f6f8",
          "dark": {
            "backgroundColor": "#0b0b0c"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

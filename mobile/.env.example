# Copy to .env (gitignored) for local development; for EAS builds set the same names as EAS environment variables.
# Everything EXPO_PUBLIC_* is inlined into the app bundle and readable by anyone who has the app: NEVER put a secret here.

# The Supabase project URL, and its PUBLISHABLE key (sb_publishable_...). Never the secret key (sb_secret_...): the app refuses it.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# The Flask API (api/). http://localhost is allowed for development; production must be https.
EXPO_PUBLIC_API_URL=https://repcheck-api.onrender.com
